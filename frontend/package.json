{
  "name": "cobot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "gallery": "node scripts/build-gallery.mjs",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/generated/schema.ts"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@office-kit/pptx": "0.28.0",
    "@office-kit/pptx-preview": "0.21.0",
    "@tanstack/react-query": "^5.66.0",
    "docx-preview": "0.4.1",
    "highlight.js": "11.12.0",
    "i18next": "^24.2.2",
    "lucide-react": "^0.475.0",
    "mdast-util-from-markdown": "2.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
